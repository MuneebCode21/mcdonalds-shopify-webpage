<article class="product-card" data-product-card>
  <a href="{{ product.url }}" class="product-card__media">{% if product.featured_image %}{{ product.featured_image | image_url: width:1000 | image_tag: loading:'lazy', widths:'400,600,800,1000', sizes:'(max-width:749px) 92vw, 28vw' }}{% endif %}<span class="product-card__plus">+</span>{% if product.available == false %}<span class="product-card__badge">SOLD OUT</span>{% elsif product.compare_at_price > product.price %}<span class="product-card__badge">DEAL</span>{% endif %}</a>
  <div class="product-card__meta"><div><span class="kicker">{{ product.type | default:'MENU ITEM' }}</span><h3><a href="{{ product.url }}">{{ product.title }}</a></h3>{% if product.options_with_values.size > 0 %}<small>{{ product.options_with_values.first.values.size }} options</small>{% endif %}</div><div class="product-card__buy"><strong>{{ product.price | money }}</strong><button type="button" class="mini-add" data-quick-add="{{ product.selected_or_first_available_variant.id }}" {% unless product.available %}disabled{% endunless %}>ADD +</button></div></div>
</article>
