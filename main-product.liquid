<section class="product-detail section-wrap" data-product-page data-reveal>
  <div class="product-detail__gallery"><div class="product-detail__thumbs">{% for image in product.images %}<button type="button" class="product-detail__thumb {% if forloop.first %}is-active{% endif %}" data-gallery-thumb="{{ forloop.index0 }}">{{ image | image_url: width:160 | image_tag: loading:'lazy' }}</button>{% endfor %}</div><div class="product-detail__main">{% for image in product.images %}<div class="product-detail__image {% if forloop.first %}is-active{% endif %}" data-gallery-image="{{ forloop.index0 }}">{{ image | image_url: width:1600 | image_tag: loading:'lazy' }}</div>{% endfor %}</div></div>
  <div class="product-detail__info"><span class="kicker">{{ product.type | default:'MENU ITEM' }}</span><h1>{{ product.title }}</h1><div class="product-price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</div>{% if product.description != blank %}<div class="product-description">{{ product.description }}</div>{% endif %}
    {% form 'product', product, id:'product-form', class:'product-form', novalidate:'novalidate' %}<script type="application/json" data-variants-json>{{ product.variants | json }}</script><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-product-variant>{% for option in product.options_with_values %}<fieldset class="variant-fieldset"><legend>{{ option.name }}</legend><div class="variant-options">{% for value in option.values %}<label><input class="visually-hidden" type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}><span>{{ value }}</span></label>{% endfor %}</div></fieldset>{% endfor %}<div class="buy-row"><div class="quantity"><button type="button" data-product-qty="-1">−</button><input name="quantity" value="1" min="1" type="number" data-product-quantity><button type="button" data-product-qty="1">+</button></div><button class="mc-btn mc-btn--primary" type="submit" name="add"{% unless product.available %} disabled{% endunless %}>{% if product.available %}ADD TO ORDER{% else %}SOLD OUT{% endif %}</button></div>{% endform %}
    <div class="product-trust"><div><b>FRESHLY MADE</b><span>Prepared for your order.</span></div><div><b>ORDER YOUR WAY</b><span>Delivery, pickup or dine in.</span></div><div><b>HALAL</b><span>Pakistan market menu.</span></div></div>
  </div>
</section>
{% schema %}{"name":"Product"}{% endschema %}
