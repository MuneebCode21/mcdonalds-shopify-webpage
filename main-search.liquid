<section class="search-page section-wrap" data-reveal><span class="kicker">SEARCH</span><h1>FIND A FAVOURITE.</h1><form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search burgers, fries, McCafé..." autofocus><button class="mc-btn mc-btn--primary">SEARCH ↗</button></form>{% if search.performed %}<div class="search-results">{% for result in search.results %}{% if result.object_type == 'product' %}{% render 'product-card', product: result %}{% endif %}{% else %}<div class="cart-empty"><h2>NO MATCHES.</h2><p>Try another favourite.</p></div>{% endfor %}</div>{% endif %}</section>
{% schema %}{"name":"Search"}{% endschema %}
