<section class="cart-page section-wrap" data-cart-page data-reveal>
  <div class="section-heading"><div><span class="kicker">YOUR ORDER</span><h1>BAG / CART</h1></div><a href="{{ routes.all_products_collection_url }}" class="text-arrow">KEEP SHOPPING ↗</a></div>
  {% if cart.item_count == 0 %}<div class="cart-empty"><div class="cart-empty__mark">M</div><h2>NOTHING HERE YET.</h2><p>Start with a favourite, then build from there.</p><a href="{{ routes.all_products_collection_url }}" class="mc-btn mc-btn--primary">BROWSE MENU <span>↗</span></a></div>{% else %}<div class="cart-layout"><div>{% for item in cart.items %}<article class="cart-page-line"><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width:300 | image_tag: loading:'lazy' }}{% endif %}</a><div><span class="kicker">{{ item.product.type }}</span><h3>{{ item.product.title }}</h3><p>{{ item.variant.title }}</p><div class="quantity"><button type="button" data-cart-qty data-line="{{ forloop.index }}" data-quantity="{{ item.quantity | minus:1 }}">−</button><input value="{{ item.quantity }}" readonly><button type="button" data-cart-qty data-line="{{ forloop.index }}" data-quantity="{{ item.quantity | plus:1 }}">+</button></div></div><strong>{{ item.final_line_price | money }}</strong></article>{% endfor %}</div><aside class="cart-summary"><span class="kicker">SUMMARY</span><div><span>SUBTOTAL</span><strong>{{ cart.total_price | money }}</strong></div><a href="{{ routes.checkout_url }}" class="mc-btn mc-btn--primary">CHECKOUT <span>↗</span></a></aside></div>{% endif %}
</section>
{% schema %}{"name":"Cart"}{% endschema %}
