{% paginate collection.products by 24 %}
<section class="collection-page" data-reveal>
  <div class="section-wrap collection-hero"><div><span class="kicker">MENU / {{ collection.title }}</span><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<p>{{ collection.description | strip_html | truncate:220 }}</p>{% endif %}</div><span class="collection-count">{{ collection.products_count }} ITEMS</span></div>
  <div class="section-wrap collection-toolbar"><div class="collection-toolbar__left"><button type="button" class="filter-trigger" data-filter-open>FILTER <span data-filter-count></span></button><span>{{ collection.products_count }} results</span></div><form action="{{ collection.url }}" method="get" class="sort-form"><label for="SortBy">SORT</label><select id="SortBy" name="sort_by" data-sort-select aria-label="Sort products"><option value="manual"{% if collection.sort_by == 'manual' or collection.sort_by == blank %} selected{% endif %}>Featured</option><option value="best-selling"{% if collection.sort_by == 'best-selling' %} selected{% endif %}>Best selling</option><option value="price-ascending"{% if collection.sort_by == 'price-ascending' %} selected{% endif %}>Price: low to high</option><option value="price-descending"{% if collection.sort_by == 'price-descending' %} selected{% endif %}>Price: high to low</option><option value="created-descending"{% if collection.sort_by == 'created-descending' %} selected{% endif %}>Newest</option></select></form></div>
  <div class="filter-drawer" data-filter-drawer aria-hidden="true"><div class="filter-drawer__backdrop" data-filter-close></div><aside class="filter-drawer__panel"><header><span class="kicker">REFINE</span><button type="button" data-filter-close>×</button></header><form action="{{ collection.url }}" method="get">{% if collection.filters.size > 0 %}{% for filter in collection.filters %}<fieldset><legend>{{ filter.label }}</legend>{% for value in filter.values limit:20 %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}><span>{{ value.label }}</span><em>{{ value.count }}</em></label>{% endfor %}</fieldset>{% endfor %}<button class="mc-btn mc-btn--primary" type="submit">APPLY FILTERS</button>{% else %}<p class="filter-empty">Native Shopify filters appear automatically when the imported catalogue has product attributes.</p>{% endif %}</form></aside></div>
  <div class="section-wrap"><div class="product-grid">{% if collection.products_count > 0 %}{% for product in collection.products %}{% render 'product-card', product: product %}{% endfor %}{% else %}<div class="demo-grid">{% assign demo_names='Big Mac|McChicken|Spicy McCrispy|McArabia|Chicken McNuggets|McFlurry Oreo|French Fries|McFloat' | split:'|' %}{% assign demo_imgs='https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=1200&q=88|https://images.unsplash.com/photo-1550317138-10000687a72b?auto=format&fit=crop&w=1200&q=88|https://images.unsplash.com/photo-1606755962773-d324e0a13086?auto=format&fit=crop&w=1200&q=88|https://images.unsplash.com/photo-1552566626-52f8b828add9?auto=format&fit=crop&w=1200&q=88|https://images.unsplash.com/photo-1594007654729-407eedc4be65?auto=format&fit=crop&w=1200&q=88|https://images.unsplash.com/photo-1579954115545-a95591f28bfc?auto=format&fit=crop&w=1200&q=88|https://images.unsplash.com/photo-1573080496219-bb080dd4f877?auto=format&fit=crop&w=1200&q=88|https://images.unsplash.com/photo-1544145945-f90425340c7e?auto=format&fit=crop&w=1200&q=88' | split:'|' %}{% for i in (0..7) %}<article class="product-card"><a class="product-card__media" href="{{ routes.all_products_collection_url }}"><img src="{{ demo_imgs[i] }}" alt="{{ demo_names[i] }}" loading="lazy"></a><div class="product-card__meta"><div><span class="kicker">PREVIEW ITEM</span><h3>{{ demo_names[i] }}</h3></div><a href="{{ routes.all_products_collection_url }}" class="mini-add">VIEW ↗</a></div></article>{% endfor %}</div>{% endif %}</div></div>
</section>
{% if paginate.pages > 1 %}<div class="pager section-wrap">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">← PREVIOUS</a>{% endif %}<span>{{ paginate.current_page }} / {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">NEXT →</a>{% endif %}</div>{% endif %}
{% endpaginate %}
{% schema %}{"name":"Collection"}{% endschema %}
