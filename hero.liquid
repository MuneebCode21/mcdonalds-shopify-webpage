<section class="mc-hero" id="home" data-hero>
  <div class="mc-hero__media">
    {% if section.settings.video != blank %}
      {{ section.settings.video | video_tag: autoplay:true, loop:true, muted:true, controls:false, playsinline:true, class:'mc-hero__video' }}
    {% endif %}
    <div class="mc-hero__image mc-hero__image--back"></div>
    <div class="mc-hero__shade"></div>
    <div class="mc-hero__grain"></div>
  </div>
  <div class="mc-hero__content" data-reveal>
    <span class="kicker mc-hero__kicker">{{ section.settings.kicker }}</span>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.copy }}</p>
    <div class="mc-hero__actions">
      <a href="#menu" class="mc-btn mc-btn--primary">{{ section.settings.button_text }} <span>↗</span></a>
      <a href="#order" class="mc-btn mc-btn--light">ORDER NOW <span>↗</span></a>
    </div>
  </div>
  <div class="mc-hero__side" aria-hidden="true"><span>01</span><i></i><span>09</span></div>
  <div class="mc-hero__bottom"><span>LAHORE · ISLAMABAD · KARACHI</span><span>ORDER · EARN · DISCOVER</span><span>SCROLL ↓</span></div>
</section>
{% schema %}{"name":"McD Hero","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"McDONALD'S PAKISTAN · 2026"},{"type":"text","id":"heading","label":"Heading","default":"I'M LOVIN' IT."},{"type":"textarea","id":"copy","label":"Copy","default":"Your favourites. Freshly made. Delivered your way — in Lahore, Islamabad, Rawalpindi, Karachi and beyond."},{"type":"text","id":"button_text","label":"Primary button","default":"EXPLORE THE MENU"},{"type":"video","id":"video","label":"Optional hero video"}],"presets":[{"name":"McD Hero"}]}{% endschema %}
